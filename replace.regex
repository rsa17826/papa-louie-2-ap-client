@file \.as$
@regex (^ *(public|private) var.*)(?:\n{2,})(^ *\2 var.*)
@replace $1
$3
@untilfail
@endregex
! @js
! const tokens = [];
! let i = 0;
! const len = text.length;

! // 1. Lexical Scanner / Tokenizer (Safely handles strings and comments)
! while (i < len) {
!   let char = text[i];
!   let nextChar = text[i + 1];

!   // Comments
!   if (char === '/' && nextChar === '/') {
!     let start = i;
!     i += 2;
!     while (i < len && text[i] !== '\n' && text[i] !== '\r') i++;
!     tokens.push({type: 'COMMENT', start, end: i});
!     continue;
!   }
!   if (char === '/' && nextChar === '*') {
!     let start = i;
!     i += 2;
!     while (i < len && !(text[i] === '*' && text[i + 1] === '/')) i++;
!     if (i < len) i += 2;
!     tokens.push({type: 'COMMENT', start, end: i});
!     continue;
!   }

!   // Strings ('...' or "...")
!   if (char === '"' || char === '\'') {
!     let start = i;
!     let quote = char;
!     i++;
!     while (i < len) {
!       if (text[i] === '\\') {
!         i += 2;
!         continue;
!       }
!       if (text[i] === quote) {
!         i++;
!         break;
!       }
!       i++;
!     }
!     tokens.push({type: 'STRING', start, end: i});
!     continue;
!   }

!   // Braces
!   if (char === '{' || char === '}') {
!     tokens.push({type: 'PUNCTUATION', start: i, end: i + 1, value: char});
!     i++;
!     continue;
!   }

!   // Identifiers & Keywords
!   if (/[a-zA-Z_$]/.test(char)) {
!     let start = i;
!     while (i < len && /[a-zA-Z0-9_$]/.test(text[i])) {
!       i++;
!     }
!     tokens.push(
!         {type: 'IDENTIFIER', start, end: i, value: text.slice(start, i)});
!     continue;
!   }

!   // Other characters / Whitespace
!   tokens.push({type: 'OTHER', start: i, end: i + 1, value: char});
!   i++;
! }

! // 2. Build Brace Map for Scope Matching
! const braceMap =
!     new Map();  // maps closing '}' token index to opening '{' token index
! const openBraces = [];

! tokens.forEach((t, idx) => {
!   if (t.value === '{') {
!     openBraces.push(idx);
!   } else if (t.value === '}') {
!     if (openBraces.length > 0) {
!       let openIdx = openBraces.pop();
!       braceMap.set(idx, openIdx);
!     }
!   }
! });

! const replacements = [];

! // 3. Scan for declarations like: var _loc1_:Type = this;
! for (let idx = 0; idx < tokens.length - 6; idx++) {
!   if (tokens[idx].value === 'var' && tokens[idx + 1].type === 'IDENTIFIER' &&
!       /^_loc\d+$/.test(tokens[idx + 1].value) &&
!       tokens[idx + 2].value === ':' && tokens[idx + 3].type === 'IDENTIFIER' &&
!       tokens[idx + 4].value === '=' && tokens[idx + 5].value === 'this' &&
!       tokens[idx + 6].value === ';') {
!     let varName = tokens[idx + 1].value;
!     let declStart = tokens[idx].start;
!     let declEnd = tokens[idx + 6].end;

!     // Include trailing newline if present to clean up blank lines
!     if (text[declEnd] === '\r' && text[declEnd + 1] === '\n')
!       declEnd += 2;
!     else if (text[declEnd] === '\n' || text[declEnd] === '\r')
!       declEnd += 1;

!     // Find enclosing function/block scope
!     let enclosingOpenBraceIdx = -1;
!     for (let bIdx = idx; bIdx >= 0; bIdx--) {
!       if (tokens[bIdx].value === '{') {
!         for (let [closeIdx, openIdx] of braceMap.entries()) {
!           if (openIdx === bIdx && closeIdx > idx) {
!             enclosingOpenBraceIdx = bIdx;
!             break;
!           }
!         }
!         if (enclosingOpenBraceIdx !== -1) break;
!       }
!     }

!     if (enclosingOpenBraceIdx !== -1) {
!       let enclosingCloseIdx = -1;
!       for (let [closeIdx, openIdx] of braceMap.entries()) {
!         if (openIdx === enclosingOpenBraceIdx) {
!           enclosingCloseIdx = closeIdx;
!           break;
!         }
!       }

!       // Add replacement to remove the declaration statement
!       replacements.push({start: declStart, end: declEnd, text: ''});

!       // Replace all occurrences of `_loc1_` inside this scope with `this`
!       for (let tIdx = enclosingOpenBraceIdx + 1; tIdx < enclosingCloseIdx;
!            tIdx++) {
!         let tok = tokens[tIdx];
!         if (tok.type === 'IDENTIFIER' && tok.value === varName) {
!           replacements.push({start: tok.start, end: tok.end, text: 'this'});
!         }
!       }
!     }
!   }
! }

! // Sort replacements by start index ascending
! replacements.sort((a, b) => a.start - b.start);
! return replacements;
! @endjs
